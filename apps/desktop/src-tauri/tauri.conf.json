{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Plane AI-Scenery Builder",
  "version": "0.1.0",
  "identifier": "org.xpsb.scenerybuilder",
  "build": {
    "beforeDevCommand": "pnpm --filter frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "X-Plane AI-Scenery Builder",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://tiles.openfreemap.org",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://tiles.openfreemap.org"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "X-Plane AI-Scenery Builder contributors",
    "copyright": "MIT License",
    "shortDescription": "Objects and surfaces for X-Plane 12 from OpenStreetMap and AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/",
      "resources/bin/": "bin/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
